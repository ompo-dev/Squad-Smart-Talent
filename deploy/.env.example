# Copy per environment. Use distinct secrets, URLs, ports and persistent volumes.
# Generate a URL-safe database password, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_a_unique_hex_password
DATABASE_URL=postgresql://telemetry:replace_with_a_unique_hex_password@postgres:5432/telemetry
BETTER_AUTH_URL=https://dev.example.com
REALTIME_PUBLIC_URL=wss://dev-events.example.com
REALTIME_ALLOWED_ORIGINS=https://dev.example.com
WEB_PORT=3100
REALTIME_PORT=3102
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEBHOOK_SECRET=
