{
  "name": "telemetria-command-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/copy-doc-assets.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "test:agent": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "data:import": "tsx scripts/ingest.ts",
    "worker": "tsx scripts/worker.ts",
    "realtime": "tsx scripts/realtime.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test:pipeline": "node --test tests/pipeline.test.mjs",
    "test:e2e": "tsx tests/docker-flow.ts",
    "db:seed:ci": "node scripts/seed-ci.mjs",
    "test:ci": "tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=reports/tests.xml tests/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@openuidev/lang-core": "^1.0.1",
    "@openuidev/react-headless": "^0.18.1",
    "@openuidev/react-lang": "^1.0.1",
    "@openuidev/react-ui": "^0.18.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^6.0.315",
    "axios": "^1.7.9",
    "better-auth": "^1.7.12",
    "bullmq": "^6.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "redis": "^6.3.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "swagger-ui-dist": "^5.34.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
